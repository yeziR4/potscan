{
  "name": "potscan",
  "private": true,
  "version": "0.1.0",
  "description": "Explorer and developer portal for Portaldot V3: Solidity and ink! contracts, address mapping, network status.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @potscan/web",
    "start": "npm run start -w @potscan/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
